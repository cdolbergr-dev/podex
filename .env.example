# static | database | sample | live
# static: full catalog downloaded during `npm run build` (no database) — used on Vercel.
# Unset: MySQL env → database, else downloaded catalog → static, else sample.
POKEMON_TCG_DATA_SOURCE=database

# Static mode: reuse a downloaded catalog younger than this many hours (default 20)
# CATALOG_MAX_AGE_HOURS=20

# Vercel deploy hook the daily cron calls to rebuild the site with a fresh catalog
# VERCEL_DEPLOY_HOOK_URL=

# CardNexus partner (media partner) ID from Impact; card pages then use affiliate links
# CARDNEXUS_PARTNER_ID=

# TCGdex language code for API paths (default: en)
TCGDEX_LANG=en

# MySQL (server). Use DATABASE_URL or individual vars.
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/podex
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=podex
MYSQL_PASSWORD=
MYSQL_DATABASE=podex

# Bearer token for the cron endpoints (/api/cron/rebuild-catalog, /api/cron/sync-catalog)
# and POST /api/catalog/revalidate. On Vercel, its cron jobs send it automatically.
CRON_SECRET=

# Where `npm run sync-catalog` asks the running site to refresh its cached catalog
# (defaults to NEXT_PUBLIC_SITE_URL, then http://localhost:3000)
# CATALOG_REVALIDATE_URL=http://localhost:3000

# Public origin of the site, used for sitemap, robots and social preview URLs
NEXT_PUBLIC_SITE_URL=https://podexcards.com

# Daily Instagram post of the card of the day (/api/cron/instagram). Instagram API with
# Unified Login: the Instagram account ID and the access token (see instagram/README.md).
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
