{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "rebuild-catalog": {
      "schedule": "0 4 * * 1",
      "path": "/api/cron/rebuild-catalog",
      "requestMethod": "GET"
    },
    "indexnow": {
      "schedule": "0 5 * * 1",
      "path": "/api/cron/indexnow",
      "requestMethod": "GET"
    },
    "instagram": {
      "schedule": "0 16 * * *",
      "path": "/api/cron/instagram",
      "requestMethod": "GET"
    },
    "pinterest": {
      "schedule": "10 16 * * *",
      "path": "/api/cron/pinterest",
      "requestMethod": "GET"
    },
    "new-sets": {
      "schedule": "0 6 * * *",
      "path": "/api/cron/new-sets",
      "requestMethod": "GET"
    }
  }
}
