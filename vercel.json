{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "rebuild-catalog": {
      "schedule": "0 4 * * 1",
      "path": "/api/cron/rebuild-catalog",
      "requestMethod": "GET"
    },
    "indexnow": {
      "schedule": "0 5 * * 1",
      "path": "/api/cron/indexnow",
      "requestMethod": "GET"
    },
    "instagram": {
      "schedule": "0 16 * * *",
      "path": "/api/cron/instagram",
      "requestMethod": "GET"
    }
  }
}
